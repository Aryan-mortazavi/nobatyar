# =============================================================
# Telegram Appointment Booking System - example environment file
# Copy this file to ".env" and fill in your own values.
# NEVER commit the real ".env" file to git.
# =============================================================

# Telegram bot token, obtained from @BotFather
BOT_TOKEN=

# Comma separated Telegram IDs of system administrators
# Example: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# SQLite database location (default: ./data/app.db)
DATABASE_URL=sqlite:///./data/app.db

# Secret key used to sign web admin sessions (use a long random string)
SECRET_KEY=

# Credentials for the FastAPI web admin panel
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=

# Timezone used for every appointment (IANA name)
TIMEZONE=Asia/Tehran

# Optional: logging level -> DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Optional: host and port of the web admin panel
WEB_HOST=127.0.0.1
WEB_PORT=8000
