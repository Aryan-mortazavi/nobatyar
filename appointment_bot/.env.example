# ─── Telegram bot token (from @BotFather) ──────────────────────────────────
BOT_TOKEN=

# ─── NobatYar web app — the single source of truth ──────────────────────────
# Where the booking service runs. The bot refuses to start if this is unreachable.
WEB_API_URL="http://localhost:3000"

# The same value as CHANNEL_API_SECRET in ../nobatyar/.env.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CHANNEL_API_SECRET=""

# The public website customers are handed over to ("book on the website").
PUBLIC_WEB_URL="http://localhost:3000"

# ─── Telegram network ──────────────────────────────────────────────────────
# Some hosts advertise an IPv6 address that black-holes, which makes Telegram
# look unreachable. Default `ipv4`; use `any` to keep the OS behaviour.
TELEGRAM_IP_FAMILY="ipv4"

# ─── Interface ─────────────────────────────────────────────────────────────
LOCALE="fa"

# ─── Misc ──────────────────────────────────────────────────────────────────
LOG_LEVEL="INFO"
