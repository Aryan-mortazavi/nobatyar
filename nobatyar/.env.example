# ─── Database ──────────────────────────────────────────────────────────────
# SQLite (default, zero setup)
DATABASE_URL="file:./dev.db"
# PostgreSQL (production / Docker):
# DATABASE_URL="postgresql://nobatyar:nobatyar@localhost:5432/nobatyar?schema=public"

# ─── Auth ──────────────────────────────────────────────────────────────────
# 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-me-with-a-48-byte-random-string"

# Protects /api/cron/* (set the same value in your scheduler)
CRON_SECRET=""

# ─── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="fa"

# ─── Notifications (all optional — a missing key disables that channel) ─────
# Telegram: operational alerts to the business (new bookings, cancellations).
# The IDs are the chat IDs of the admins who should receive them.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_IDS=""

# WhatsApp Cloud API: customer confirmations, reminders and waitlist offers
# (a permanent-access token from the Meta dashboard).
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Email: plug a real provider into `src/lib/channels.ts` (Resend / SES / SMTP).
# With no provider configured, messages are logged instead of sent.
SMTP_URL=""
RESEND_API_KEY=""
